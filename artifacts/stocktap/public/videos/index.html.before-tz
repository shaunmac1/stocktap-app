  <script type="application/ld+json">{"@context": "https://schema.org", "@type": "ItemList", "name": "How to use StockTap", "itemListElement": [{"@type": "ListItem", "position": 1, "item": {"@type": "VideoObject", "name": "Your first count", "description": "Pick your biggest sellers from the catalogue and start counting in minutes.", "thumbnailUrl": "https://stocktap.net/media/help/first-count.jpg", "contentUrl": "https://stocktap.net/media/help/first-count.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 2, "item": {"@type": "VideoObject", "name": "Your home screen", "description": "Stock value and GP at a glance, and where everything starts.", "thumbnailUrl": "https://stocktap.net/media/help/home-tour.jpg", "contentUrl": "https://stocktap.net/media/help/home-tour.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 3, "item": {"@type": "VideoObject", "name": "Add lines from the catalogue", "description": "Search the UK pub catalogue and add the lines you sell in one go.", "thumbnailUrl": "https://stocktap.net/media/help/library-add-from-catalogue.jpg", "contentUrl": "https://stocktap.net/media/help/library-add-from-catalogue.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 4, "item": {"@type": "VideoObject", "name": "Add your own product", "description": "Not in the catalogue? Type the name and the rest fills in.", "thumbnailUrl": "https://stocktap.net/media/help/library-add-product.jpg", "contentUrl": "https://stocktap.net/media/help/library-add-product.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 5, "item": {"@type": "VideoObject", "name": "Weigh a full bottle once", "description": "One full, sealed bottle on the scale. Every count after is to the gram.", "thumbnailUrl": "https://stocktap.net/media/help/library-weigh-bottle.jpg", "contentUrl": "https://stocktap.net/media/help/library-weigh-bottle.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 6, "item": {"@type": "VideoObject", "name": "Prices and par levels", "description": "Cost, sell price and par level for every line on one screen.", "thumbnailUrl": "https://stocktap.net/media/help/library-prices-and-pars.jpg", "contentUrl": "https://stocktap.net/media/help/library-prices-and-pars.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 7, "item": {"@type": "VideoObject", "name": "Your counting areas", "description": "Add the cellar, back bar or function room and count each one.", "thumbnailUrl": "https://stocktap.net/media/help/settings-locations.jpg", "contentUrl": "https://stocktap.net/media/help/settings-locations.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 8, "item": {"@type": "VideoObject", "name": "Counting and defaults", "description": "The areas you count, your measure, and how often you order.", "thumbnailUrl": "https://stocktap.net/media/help/settings-counting.jpg", "contentUrl": "https://stocktap.net/media/help/settings-counting.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 9, "item": {"@type": "VideoObject", "name": "Start a stocktake", "description": "The tips, picking lines, then count and tap Next. In the order you walk it.", "thumbnailUrl": "https://stocktap.net/media/help/stocktake-start.jpg", "contentUrl": "https://stocktap.net/media/help/stocktake-start.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 10, "item": {"@type": "VideoObject", "name": "Weigh a new bottle", "description": "One full sealed bottle on the scale, once. Then weigh the open one to the ml.", "thumbnailUrl": "https://stocktap.net/media/help/stocktake-weigh-setup.jpg", "contentUrl": "https://stocktap.net/media/help/stocktake-weigh-setup.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 11, "item": {"@type": "VideoObject", "name": "Cask ale on the dip rod", "description": "Read the pints off your dip rod. Or set a full depth once and use a ruler.", "thumbnailUrl": "https://stocktap.net/media/help/stocktake-casks.jpg", "contentUrl": "https://stocktap.net/media/help/stocktake-casks.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 12, "item": {"@type": "VideoObject", "name": "Bar and cellar", "description": "Same drink in two spots? Count both and it adds them up. The spot sticks.", "thumbnailUrl": "https://stocktap.net/media/help/stocktake-spots.jpg", "contentUrl": "https://stocktap.net/media/help/stocktake-spots.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 13, "item": {"@type": "VideoObject", "name": "Weigh spirits, then spot check", "description": "Weigh the open bottle to the gram. Next day, spot check it against the till.", "thumbnailUrl": "https://stocktap.net/media/help/weighing-spot-check.jpg", "contentUrl": "https://stocktap.net/media/help/weighing-spot-check.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 14, "item": {"@type": "VideoObject", "name": "Spirits in tenths", "description": "No scale to hand? Tap where the drink comes up to.", "thumbnailUrl": "https://stocktap.net/media/help/spirits-tenths.jpg", "contentUrl": "https://stocktap.net/media/help/spirits-tenths.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 15, "item": {"@type": "VideoObject", "name": "Draught in gallons", "description": "Gallons and pints, like the stocktaker's sheet. It works out the kegs.", "thumbnailUrl": "https://stocktap.net/media/help/draught-gallons.jpg", "contentUrl": "https://stocktap.net/media/help/draught-gallons.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 16, "item": {"@type": "VideoObject", "name": "Keg and box sizes", "description": "30L, 50L or 11 gallon kegs. Postmix boxes from 7 to 20 litres.", "thumbnailUrl": "https://stocktap.net/media/help/keg-box-sizes.jpg", "contentUrl": "https://stocktap.net/media/help/keg-box-sizes.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 17, "item": {"@type": "VideoObject", "name": "Count postmix", "description": "Litres of drink like your stocktaker, or boxes. Both shown.", "thumbnailUrl": "https://stocktap.net/media/help/stocktake-postmix.jpg", "contentUrl": "https://stocktap.net/media/help/stocktake-postmix.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 18, "item": {"@type": "VideoObject", "name": "Cans and bottles", "description": "Just count them. The value works itself out.", "thumbnailUrl": "https://stocktap.net/media/help/stocktake-count-units.jpg", "contentUrl": "https://stocktap.net/media/help/stocktake-count-units.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 19, "item": {"@type": "VideoObject", "name": "Review and close", "description": "Grouped by category, missing prices flagged, tap a line to fix it, then close.", "thumbnailUrl": "https://stocktap.net/media/help/stocktake-review-close.jpg", "contentUrl": "https://stocktap.net/media/help/stocktake-review-close.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 20, "item": {"@type": "VideoObject", "name": "Paste a delivery", "description": "Copy the supplier's delivery email and paste it in. Lines matched to your products.", "thumbnailUrl": "https://stocktap.net/media/help/paste-delivery.jpg", "contentUrl": "https://stocktap.net/media/help/paste-delivery.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 21, "item": {"@type": "VideoObject", "name": "What to order", "description": "Out now, running low, and what you've already got enough of. Change the days and copy the order.", "thumbnailUrl": "https://stocktap.net/media/help/order-list-explained.jpg", "contentUrl": "https://stocktap.net/media/help/order-list-explained.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 22, "item": {"@type": "VideoObject", "name": "Scan a paper delivery note", "description": "Photograph the note. Check each line, then approve it into stock and prices.", "thumbnailUrl": "https://stocktap.net/media/help/invoice-scan.jpg", "contentUrl": "https://stocktap.net/media/help/invoice-scan.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 23, "item": {"@type": "VideoObject", "name": "Your order list", "description": "What to order, from what sold between your stocktakes.", "thumbnailUrl": "https://stocktap.net/media/help/order-from-stocktakes.jpg", "contentUrl": "https://stocktap.net/media/help/order-from-stocktakes.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 24, "item": {"@type": "VideoObject", "name": "Order list from a Venners audit", "description": "Use Venners? Drop the audit in for the order, up and down and all stock.", "thumbnailUrl": "https://stocktap.net/media/help/stock-and-orders.jpg", "contentUrl": "https://stocktap.net/media/help/stock-and-orders.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 25, "item": {"@type": "VideoObject", "name": "Breakages and transfers", "description": "Log a dropped bottle so it doesn't show as a loss.", "thumbnailUrl": "https://stocktap.net/media/help/ledger-wastage.jpg", "contentUrl": "https://stocktap.net/media/help/ledger-wastage.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 26, "item": {"@type": "VideoObject", "name": "Reports", "description": "Valuation, GP by line, by location, cost of sales and the order guide.", "thumbnailUrl": "https://stocktap.net/media/help/reports-tour.jpg", "contentUrl": "https://stocktap.net/media/help/reports-tour.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 27, "item": {"@type": "VideoObject", "name": "The Daily Board", "description": "One number a night, against last week, your average and the same night up to 3 years ago.", "thumbnailUrl": "https://stocktap.net/media/help/daily-board.jpg", "contentUrl": "https://stocktap.net/media/help/daily-board.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 28, "item": {"@type": "VideoObject", "name": "Fill in or fix a past night", "description": "Go back a day or pick any date. Unsaved figures are kept, and it tells you.", "thumbnailUrl": "https://stocktap.net/media/help/board-past-days.jpg", "contentUrl": "https://stocktap.net/media/help/board-past-days.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 29, "item": {"@type": "VideoObject", "name": "Weeks and months", "description": "Every week and month against last year, with wages as a % of takings. Tap a week for its days.", "thumbnailUrl": "https://stocktap.net/media/help/board-weeks-months.jpg", "contentUrl": "https://stocktap.net/media/help/board-weeks-months.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 30, "item": {"@type": "VideoObject", "name": "Was the act worth it?", "description": "Put in the fee and see if the band or match paid for itself, plus the wet and dry split.", "thumbnailUrl": "https://stocktap.net/media/help/board-was-it-worth-it.jpg", "contentUrl": "https://stocktap.net/media/help/board-was-it-worth-it.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 31, "item": {"@type": "VideoObject", "name": "Bring in past takings", "description": "Paste years of takings from your spreadsheet in one go.", "thumbnailUrl": "https://stocktap.net/media/help/board-import-takings.jpg", "contentUrl": "https://stocktap.net/media/help/board-import-takings.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 32, "item": {"@type": "VideoObject", "name": "Finances", "description": "Bills and takings, what's payable and the VAT.", "thumbnailUrl": "https://stocktap.net/media/help/finances-add.jpg", "contentUrl": "https://stocktap.net/media/help/finances-add.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 33, "item": {"@type": "VideoObject", "name": "Deals and offers", "description": "Add a deal so spot checks value those pours at the deal price.", "thumbnailUrl": "https://stocktap.net/media/help/settings-offers.jpg", "contentUrl": "https://stocktap.net/media/help/settings-offers.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 34, "item": {"@type": "VideoObject", "name": "Your plan", "description": "Pro and Premium, 14 days free. Cancel any time from Settings.", "thumbnailUrl": "https://stocktap.net/media/help/settings-plan.jpg", "contentUrl": "https://stocktap.net/media/help/settings-plan.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 35, "item": {"@type": "VideoObject", "name": "Team and wages", "description": "Add the team, tap to clock in, wages live against the take.", "thumbnailUrl": "https://stocktap.net/media/help/team-and-clock.jpg", "contentUrl": "https://stocktap.net/media/help/team-and-clock.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 36, "item": {"@type": "VideoObject", "name": "The rota", "description": "Bar and kitchen shifts, quick fill, copy last week.", "thumbnailUrl": "https://stocktap.net/media/help/rota.jpg", "contentUrl": "https://stocktap.net/media/help/rota.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 37, "item": {"@type": "VideoObject", "name": "Daily checks", "description": "Temperatures and opening and closing checklists on the staff phones.", "thumbnailUrl": "https://stocktap.net/media/help/checks-temperatures.jpg", "contentUrl": "https://stocktap.net/media/help/checks-temperatures.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 38, "item": {"@type": "VideoObject", "name": "Add, change or remove a check", "description": "Add a fridge, change a safe range, take one off. It asks before removing anything.", "thumbnailUrl": "https://stocktap.net/media/help/checks-manage.jpg", "contentUrl": "https://stocktap.net/media/help/checks-manage.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 39, "item": {"@type": "VideoObject", "name": "Fill in a missed check", "description": "Go back to any day. Anything added later is marked as filled in later.", "thumbnailUrl": "https://stocktap.net/media/help/checks-past-day.jpg", "contentUrl": "https://stocktap.net/media/help/checks-past-day.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 40, "item": {"@type": "VideoObject", "name": "Staff phone codes", "description": "Give each person their own code to link their phone.", "thumbnailUrl": "https://stocktap.net/media/help/staff-phone.jpg", "contentUrl": "https://stocktap.net/media/help/staff-phone.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 41, "item": {"@type": "VideoObject", "name": "On the staff phone", "description": "Staff clock in, log temperatures, tick the checks and log refusals. No wages, no takings.", "thumbnailUrl": "https://stocktap.net/media/help/staff-phone-view.jpg", "contentUrl": "https://stocktap.net/media/help/staff-phone-view.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 42, "item": {"@type": "VideoObject", "name": "Checks history", "description": "Every temperature, tick and refusal, who did it and when. Look back or download it.", "thumbnailUrl": "https://stocktap.net/media/help/checks-history.jpg", "contentUrl": "https://stocktap.net/media/help/checks-history.mp4", "uploadDate": "2026-09-29"}}, {"@type": "ListItem", "position": 43, "item": {"@type": "VideoObject", "name": "Suggest a feature", "description": "Tell us what to build next and vote on other ideas.", "thumbnailUrl": "https://stocktap.net/media/help/suggestions.jpg", "contentUrl": "https://stocktap.net/media/help/suggestions.mp4", "uploadDate": "2026-09-29"}}]}</script>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:"Space Grotesk",system-ui,sans-serif;background:#111316;color:#F3F1EC;line-height:1.5}
    header{max-width:1040px;margin:0 auto;padding:20px 24px;display:flex;align-items:center;justify-content:space-between}
    .brand{display:flex;align-items:center;gap:8px;font-weight:700;color:#F3F1EC;text-decoration:none}
    .brand span{width:28px;height:28px;border-radius:6px;background:#E0A343;display:inline-block}
    nav a{color:#8A9099;text-decoration:none;margin-left:16px;font-size:14px} nav a:hover{color:#F3F1EC}
    main{max-width:1040px;margin:0 auto;padding:16px 24px 64px}
    h1{font-size:34px;line-height:1.15;margin:18px 0 8px}
    .lead{color:#8A9099;max-width:640px;margin-bottom:28px}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:20px}
    .card{background:#1A1D21;border:1px solid #2A2E34;border-radius:14px;overflow:hidden}
    .card video{width:100%;aspect-ratio:390/844;background:#000;display:block}
    .body{padding:14px 16px} h3{font-size:17px;margin-bottom:6px} .group{font-size:20px;margin:26px 0 12px;color:#E0A343} .body p{font-size:13px;color:#8A9099}
    .cta{margin-top:40px;border:1px solid #2A2E34;border-radius:14px;padding:28px;text-align:center;background:#1A1D21}
    .btn{display:inline-block;margin-top:12px;background:#E0A343;color:#111316;font-weight:700;padding:12px 22px;border-radius:8px;text-decoration:none}
    footer{border-top:1px solid #2A2E34;padding:20px 24px;text-align:center;font-size:12px;color:#8A9099} footer a{color:#8A9099;margin:0 8px}
  
    .jump{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 8px} .jump a{font-size:13px;color:#F3F1EC;border:1px solid #2A2E34;border-radius:999px;padding:6px 12px;text-decoration:none}
  </style>
</head>
<body>
  <header><a class="brand" href="/"><span></span>StockTap</a><nav><a href="/problems/">Problems we fix</a><a href="/guides/">Guides</a><a href="/help">Help</a><a href="/auth">Sign in</a></nav></header>
  <main>
    <h1>How to use StockTap</h1>
    <p class="lead">43 short videos of every screen, step by step on a phone, with things being added as you watch. The same videos are behind the “How to” button in the app.</p>
    <div class="jump"><a href="#getting-started">Getting started</a><a href="#stocktakes">Stocktakes</a><a href="#deliveries-and-orders">Deliveries and orders</a><a href="#money-and-reports">Money and reports</a><a href="#team">Team</a><a href="#more">More</a></div>
    <h2 class="group" id="getting-started">Getting started</h2>
    <div class="grid">
      <article class="card" id="first-count">
        <video controls playsinline preload="none" poster="/media/help/first-count.jpg" src="/media/help/first-count.mp4" aria-label="Your first count"></video>
        <div class="body"><h3>Your first count</h3><p>Pick your biggest sellers from the catalogue and start counting in minutes.</p></div>
      </article>
      <article class="card" id="home-tour">
        <video controls playsinline preload="none" poster="/media/help/home-tour.jpg" src="/media/help/home-tour.mp4" aria-label="Your home screen"></video>
        <div class="body"><h3>Your home screen</h3><p>Stock value and GP at a glance, and where everything starts.</p></div>
      </article>
      <article class="card" id="library-add-from-catalogue">
        <video controls playsinline preload="none" poster="/media/help/library-add-from-catalogue.jpg" src="/media/help/library-add-from-catalogue.mp4" aria-label="Add lines from the catalogue"></video>
        <div class="body"><h3>Add lines from the catalogue</h3><p>Search the UK pub catalogue and add the lines you sell in one go.</p></div>
      </article>
      <article class="card" id="library-add-product">
        <video controls playsinline preload="none" poster="/media/help/library-add-product.jpg" src="/media/help/library-add-product.mp4" aria-label="Add your own product"></video>
        <div class="body"><h3>Add your own product</h3><p>Not in the catalogue? Type the name and the rest fills in.</p></div>
      </article>
      <article class="card" id="library-weigh-bottle">
        <video controls playsinline preload="none" poster="/media/help/library-weigh-bottle.jpg" src="/media/help/library-weigh-bottle.mp4" aria-label="Weigh a full bottle once"></video>
        <div class="body"><h3>Weigh a full bottle once</h3><p>One full, sealed bottle on the scale. Every count after is to the gram.</p></div>
      </article>
      <article class="card" id="library-prices-and-pars">
        <video controls playsinline preload="none" poster="/media/help/library-prices-and-pars.jpg" src="/media/help/library-prices-and-pars.mp4" aria-label="Prices and par levels"></video>
        <div class="body"><h3>Prices and par levels</h3><p>Cost, sell price and par level for every line on one screen.</p></div>
      </article>
      <article class="card" id="settings-locations">
        <video controls playsinline preload="none" poster="/media/help/settings-locations.jpg" src="/media/help/settings-locations.mp4" aria-label="Your counting areas"></video>
        <div class="body"><h3>Your counting areas</h3><p>Add the cellar, back bar or function room and count each one.</p></div>
      </article>
      <article class="card" id="settings-counting">
        <video controls playsinline preload="none" poster="/media/help/settings-counting.jpg" src="/media/help/settings-counting.mp4" aria-label="Counting and defaults"></video>
        <div class="body"><h3>Counting and defaults</h3><p>The areas you count, your measure, and how often you order.</p></div>
      </article>
    </div>
    <h2 class="group" id="stocktakes">Stocktakes</h2>
    <div class="grid">
      <article class="card" id="stocktake-start">
        <video controls playsinline preload="none" poster="/media/help/stocktake-start.jpg" src="/media/help/stocktake-start.mp4" aria-label="Start a stocktake"></video>
        <div class="body"><h3>Start a stocktake</h3><p>The tips, picking lines, then count and tap Next. In the order you walk it.</p></div>
      </article>
      <article class="card" id="stocktake-weigh-setup">
        <video controls playsinline preload="none" poster="/media/help/stocktake-weigh-setup.jpg" src="/media/help/stocktake-weigh-setup.mp4" aria-label="Weigh a new bottle"></video>
        <div class="body"><h3>Weigh a new bottle</h3><p>One full sealed bottle on the scale, once. Then weigh the open one to the ml.</p></div>
      </article>
      <article class="card" id="stocktake-casks">
        <video controls playsinline preload="none" poster="/media/help/stocktake-casks.jpg" src="/media/help/stocktake-casks.mp4" aria-label="Cask ale on the dip rod"></video>
        <div class="body"><h3>Cask ale on the dip rod</h3><p>Read the pints off your dip rod. Or set a full depth once and use a ruler.</p></div>
      </article>
      <article class="card" id="stocktake-spots">
        <video controls playsinline preload="none" poster="/media/help/stocktake-spots.jpg" src="/media/help/stocktake-spots.mp4" aria-label="Bar and cellar"></video>
        <div class="body"><h3>Bar and cellar</h3><p>Same drink in two spots? Count both and it adds them up. The spot sticks.</p></div>
      </article>
      <article class="card" id="weighing-spot-check">
        <video controls playsinline preload="none" poster="/media/help/weighing-spot-check.jpg" src="/media/help/weighing-spot-check.mp4" aria-label="Weigh spirits, then spot check"></video>
        <div class="body"><h3>Weigh spirits, then spot check</h3><p>Weigh the open bottle to the gram. Next day, spot check it against the till.</p></div>
      </article>
      <article class="card" id="spirits-tenths">
        <video controls playsinline preload="none" poster="/media/help/spirits-tenths.jpg" src="/media/help/spirits-tenths.mp4" aria-label="Spirits in tenths"></video>
        <div class="body"><h3>Spirits in tenths</h3><p>No scale to hand? Tap where the drink comes up to.</p></div>
      </article>
      <article class="card" id="draught-gallons">
        <video controls playsinline preload="none" poster="/media/help/draught-gallons.jpg" src="/media/help/draught-gallons.mp4" aria-label="Draught in gallons"></video>
        <div class="body"><h3>Draught in gallons</h3><p>Gallons and pints, like the stocktaker&#x27;s sheet. It works out the kegs.</p></div>
      </article>
      <article class="card" id="keg-box-sizes">
        <video controls playsinline preload="none" poster="/media/help/keg-box-sizes.jpg" src="/media/help/keg-box-sizes.mp4" aria-label="Keg and box sizes"></video>
        <div class="body"><h3>Keg and box sizes</h3><p>30L, 50L or 11 gallon kegs. Postmix boxes from 7 to 20 litres.</p></div>
      </article>
      <article class="card" id="stocktake-postmix">
        <video controls playsinline preload="none" poster="/media/help/stocktake-postmix.jpg" src="/media/help/stocktake-postmix.mp4" aria-label="Count postmix"></video>
        <div class="body"><h3>Count postmix</h3><p>Litres of drink like your stocktaker, or boxes. Both shown.</p></div>
      </article>
      <article class="card" id="stocktake-count-units">
        <video controls playsinline preload="none" poster="/media/help/stocktake-count-units.jpg" src="/media/help/stocktake-count-units.mp4" aria-label="Cans and bottles"></video>
        <div class="body"><h3>Cans and bottles</h3><p>Just count them. The value works itself out.</p></div>
      </article>
      <article class="card" id="stocktake-review-close">
        <video controls playsinline preload="none" poster="/media/help/stocktake-review-close.jpg" src="/media/help/stocktake-review-close.mp4" aria-label="Review and close"></video>
        <div class="body"><h3>Review and close</h3><p>Grouped by category, missing prices flagged, tap a line to fix it, then close.</p></div>
      </article>
    </div>
    <h2 class="group" id="deliveries-and-orders">Deliveries and orders</h2>
    <div class="grid">
      <article class="card" id="paste-delivery">
        <video controls playsinline preload="none" poster="/media/help/paste-delivery.jpg" src="/media/help/paste-delivery.mp4" aria-label="Paste a delivery"></video>
        <div class="body"><h3>Paste a delivery</h3><p>Copy the supplier&#x27;s delivery email and paste it in. Lines matched to your products.</p></div>
      </article>
      <article class="card" id="order-list-explained">
        <video controls playsinline preload="none" poster="/media/help/order-list-explained.jpg" src="/media/help/order-list-explained.mp4" aria-label="What to order"></video>
        <div class="body"><h3>What to order</h3><p>Out now, running low, and what you&#x27;ve already got enough of. Change the days and copy the order.</p></div>
      </article>
      <article class="card" id="invoice-scan">
        <video controls playsinline preload="none" poster="/media/help/invoice-scan.jpg" src="/media/help/invoice-scan.mp4" aria-label="Scan a paper delivery note"></video>
        <div class="body"><h3>Scan a paper delivery note</h3><p>Photograph the note. Check each line, then approve it into stock and prices.</p></div>
      </article>
      <article class="card" id="order-from-stocktakes">
        <video controls playsinline preload="none" poster="/media/help/order-from-stocktakes.jpg" src="/media/help/order-from-stocktakes.mp4" aria-label="Your order list"></video>
        <div class="body"><h3>Your order list</h3><p>What to order, from what sold between your stocktakes.</p></div>
      </article>
      <article class="card" id="stock-and-orders">
        <video controls playsinline preload="none" poster="/media/help/stock-and-orders.jpg" src="/media/help/stock-and-orders.mp4" aria-label="Order list from a Venners audit"></video>
        <div class="body"><h3>Order list from a Venners audit</h3><p>Use Venners? Drop the audit in for the order, up and down and all stock.</p></div>
      </article>
      <article class="card" id="ledger-wastage">
        <video controls playsinline preload="none" poster="/media/help/ledger-wastage.jpg" src="/media/help/ledger-wastage.mp4" aria-label="Breakages and transfers"></video>
        <div class="body"><h3>Breakages and transfers</h3><p>Log a dropped bottle so it doesn&#x27;t show as a loss.</p></div>
      </article>
    </div>
    <h2 class="group" id="money-and-reports">Money and reports</h2>
    <div class="grid">
      <article class="card" id="reports-tour">
        <video controls playsinline preload="none" poster="/media/help/reports-tour.jpg" src="/media/help/reports-tour.mp4" aria-label="Reports"></video>
        <div class="body"><h3>Reports</h3><p>Valuation, GP by line, by location, cost of sales and the order guide.</p></div>
      </article>
      <article class="card" id="daily-board">
        <video controls playsinline preload="none" poster="/media/help/daily-board.jpg" src="/media/help/daily-board.mp4" aria-label="The Daily Board"></video>
        <div class="body"><h3>The Daily Board</h3><p>One number a night, against last week, your average and the same night up to 3 years ago.</p></div>
      </article>
      <article class="card" id="board-past-days">
        <video controls playsinline preload="none" poster="/media/help/board-past-days.jpg" src="/media/help/board-past-days.mp4" aria-label="Fill in or fix a past night"></video>
        <div class="body"><h3>Fill in or fix a past night</h3><p>Go back a day or pick any date. Unsaved figures are kept, and it tells you.</p></div>
      </article>
      <article class="card" id="board-weeks-months">
        <video controls playsinline preload="none" poster="/media/help/board-weeks-months.jpg" src="/media/help/board-weeks-months.mp4" aria-label="Weeks and months"></video>
        <div class="body"><h3>Weeks and months</h3><p>Every week and month against last year, with wages as a % of takings. Tap a week for its days.</p></div>
      </article>
      <article class="card" id="board-was-it-worth-it">
        <video controls playsinline preload="none" poster="/media/help/board-was-it-worth-it.jpg" src="/media/help/board-was-it-worth-it.mp4" aria-label="Was the act worth it?"></video>
        <div class="body"><h3>Was the act worth it?</h3><p>Put in the fee and see if the band or match paid for itself, plus the wet and dry split.</p></div>
      </article>
      <article class="card" id="board-import-takings">
        <video controls playsinline preload="none" poster="/media/help/board-import-takings.jpg" src="/media/help/board-import-takings.mp4" aria-label="Bring in past takings"></video>
        <div class="body"><h3>Bring in past takings</h3><p>Paste years of takings from your spreadsheet in one go.</p></div>
      </article>
      <article class="card" id="finances-add">
        <video controls playsinline preload="none" poster="/media/help/finances-add.jpg" src="/media/help/finances-add.mp4" aria-label="Finances"></video>
        <div class="body"><h3>Finances</h3><p>Bills and takings, what&#x27;s payable and the VAT.</p></div>
      </article>
      <article class="card" id="settings-offers">
        <video controls playsinline preload="none" poster="/media/help/settings-offers.jpg" src="/media/help/settings-offers.mp4" aria-label="Deals and offers"></video>
        <div class="body"><h3>Deals and offers</h3><p>Add a deal so spot checks value those pours at the deal price.</p></div>
      </article>
      <article class="card" id="settings-plan">
        <video controls playsinline preload="none" poster="/media/help/settings-plan.jpg" src="/media/help/settings-plan.mp4" aria-label="Your plan"></video>
        <div class="body"><h3>Your plan</h3><p>Pro and Premium, 14 days free. Cancel any time from Settings.</p></div>
      </article>
    </div>
    <h2 class="group" id="team">Team</h2>
    <div class="grid">
      <article class="card" id="team-and-clock">
        <video controls playsinline preload="none" poster="/media/help/team-and-clock.jpg" src="/media/help/team-and-clock.mp4" aria-label="Team and wages"></video>
        <div class="body"><h3>Team and wages</h3><p>Add the team, tap to clock in, wages live against the take.</p></div>
      </article>
      <article class="card" id="rota">
        <video controls playsinline preload="none" poster="/media/help/rota.jpg" src="/media/help/rota.mp4" aria-label="The rota"></video>
        <div class="body"><h3>The rota</h3><p>Bar and kitchen shifts, quick fill, copy last week.</p></div>
      </article>
      <article class="card" id="checks-temperatures">
        <video controls playsinline preload="none" poster="/media/help/checks-temperatures.jpg" src="/media/help/checks-temperatures.mp4" aria-label="Daily checks"></video>
        <div class="body"><h3>Daily checks</h3><p>Temperatures and opening and closing checklists on the staff phones.</p></div>
      </article>
      <article class="card" id="checks-manage">
        <video controls playsinline preload="none" poster="/media/help/checks-manage.jpg" src="/media/help/checks-manage.mp4" aria-label="Add, change or remove a check"></video>
        <div class="body"><h3>Add, change or remove a check</h3><p>Add a fridge, change a safe range, take one off. It asks before removing anything.</p></div>
      </article>
      <article class="card" id="checks-past-day">
        <video controls playsinline preload="none" poster="/media/help/checks-past-day.jpg" src="/media/help/checks-past-day.mp4" aria-label="Fill in a missed check"></video>
        <div class="body"><h3>Fill in a missed check</h3><p>Go back to any day. Anything added later is marked as filled in later.</p></div>
      </article>
      <article class="card" id="staff-phone">
        <video controls playsinline preload="none" poster="/media/help/staff-phone.jpg" src="/media/help/staff-phone.mp4" aria-label="Staff phone codes"></video>
        <div class="body"><h3>Staff phone codes</h3><p>Give each person their own code to link their phone.</p></div>
      </article>
      <article class="card" id="staff-phone-view">
        <video controls playsinline preload="none" poster="/media/help/staff-phone-view.jpg" src="/media/help/staff-phone-view.mp4" aria-label="On the staff phone"></video>
        <div class="body"><h3>On the staff phone</h3><p>Staff clock in, log temperatures, tick the checks and log refusals. No wages, no takings.</p></div>
      </article>
      <article class="card" id="checks-history">
        <video controls playsinline preload="none" poster="/media/help/checks-history.jpg" src="/media/help/checks-history.mp4" aria-label="Checks history"></video>
        <div class="body"><h3>Checks history</h3><p>Every temperature, tick and refusal, who did it and when. Look back or download it.</p></div>
      </article>
      <article class="card" id="suggestions">
        <video controls playsinline preload="none" poster="/media/help/suggestions.jpg" src="/media/help/suggestions.mp4" aria-label="Suggest a feature"></video>
        <div class="body"><h3>Suggest a feature</h3><p>Tell us what to build next and vote on other ideas.</p></div>
      </article>
    </div>
    <div class="cta">
      <h2 style="font-size:22px">Try it on your own bar</h2>
      <p style="color:#8A9099">14 days of Pro free, no card. Your phone is all you need to start.</p>
      <a class="btn" href="/auth?mode=signup">Start free</a>
    </div>
  </main>
