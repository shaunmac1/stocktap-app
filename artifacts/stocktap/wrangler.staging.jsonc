{
  // StockTap on Cloudflare Workers: static assets + /api/stripe/* + invoice-scan proxy + nightly tier reconcile.
  // Deploy: pnpm run build, then `npx wrangler deploy --keep-vars` from this directory (see DEPLOY_RUNBOOK).
  // Secrets (STRIPE_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY, ...) live on the Worker; --keep-vars keeps dashboard vars.
  "name": "stocktap-staging-src",
